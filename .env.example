# SPHEREx Change Lens - Example Environment Configuration
# Copy this file to .env for local runtime settings.
# DO NOT commit real secrets or production credentials to this file.

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Storage & Persistence (SQLite Foundation)
SQLITE_DB_PATH=data/change_lens.db
DATA_DIR=data
CACHE_DIR=data/cached_mefs
PREVIEWS_DIR=data/previews
DERIVED_DIR=data/derived

# NASA / SPHEREx Archive Connection Settings (Placeholders / Safe Defaults)
# In local development and scaffolding, mock mode defaults to true.
SPHEREX_ARCHIVE_MOCK_MODE=true
SPHEREX_ARCHIVE_BASE_URL=https://irsa.ipac.caltech.edu/applications/ibe/
SPHEREX_TIMEOUT_SECONDS=30
# Real-archive mode: max epochs downloaded and played per query
SPHEREX_MAX_FRAMES=8
SPHEREX_MAX_CONCURRENT_DOWNLOADS=3

# Frontend Environment Settings
VITE_API_BASE_URL=http://localhost:8000
